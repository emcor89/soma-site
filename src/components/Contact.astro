---
<section id="contacto" class="px-5 md:px-0 flex justify-center items-start py-5 mt-24  mb-10  min-h-[682px]  shadow-[0px_4px_4px_rgba(0,0,0,0.25)] ">
  <div class="w-full max-w-[1080px] flex flex-col md:flex-row gap-20">
    <div class="flex flex-col-reverse md:flex-col  gap-5 w-full md:w-1/2 px-5">
      <section class="w-full text-xl font-bold text-white min-w-60 ">
        <h2 class="text-2xl font-bold font-titulos">Comunícate con Nosotros</h2>
        <p class="mt-5 text-base font-parrafos font-thin text-justify">
          Tu hogar, cuidado por manos expertas y confiables. En SOMA, seleccionamos y  
          formamos personal preparado para darte la tranquilidad que necesitas y el 
          tiempo que mereces
        </p>
        <address class="mt-5 leading-7 not-italic font-parrafos text-base font-bold">
          Telefono: 099878767<br />
          Instagram: @Somaec<br />
          Alborada Decima Etapainfosoma@soma.com
        </address>
      </section>
      <div class="max-w-[500px] mb-12 md:mb-0">
          <img
              src="/img/chofer.png"
              alt="Contact illustration"
              class="rounded-3xl"
            />
        </div>
    </div>
    
    <div class="flex flex-col justify-start items-center w-full md:w-1/2">
        <div class="max-w-full text-white w-[413px]">
          <h2 class="text-2xl font-titulos">Somos tu aliado en el hogar.</h2>
          <p class="mt-3 text-base">Déjanos ayudarte.</p>
        </div>

        <form action="https://formsubmit.co/info@soma.ec" method="POST" class="flex flex-col mt-4 w-full text-base whitespace-nowrap max-w-[413px] text-zinc-500 max-md:mt-10">
          <div class="flex gap-3.5 w-full">
            <input
              type="text"
              name="Nombre"
              placeholder="Nombre"
              class="basis-1/2 gap-2 pl-4 py-4 bg-white rounded-3xl min-h-[52px]"
              required
            />
            <input
              type="tel"
              name="Telefono"
              placeholder="Numero"
              class="basis-1/2 gap-2 pl-4 py-4 bg-white rounded-3xl min-h-[52px]"
              required
            />
          </div>

          <input
            type="email"
            name="Correo"
            placeholder="Correo"
            class="gap-2.5 self-stretch px-5 py-4 mt-4 bg-white rounded-3xl min-h-[52px] w-full"
            required
          />

          <textarea
            placeholder="Mensaje"
            name="Mensaje"
            class="gap-2.5 px-5 pt-2.5 pb-24 mt-4 bg-white rounded-3xl min-h-[127px] w-full"
            required
          ></textarea>
          <!-- OCULTOS -->
          <input type="hidden" name="_captcha" value="false" />
          <input
            type="hidden"
            name="_next"
            value="https://soma.ec/?success=true"
          />

          <button
            type="submit"
            class="gap-2.5 self-stretch px-2.5 py-4 mt-4 text-white bg-sky-900 rounded-3xl min-h-[52px] w-full hover:bg-sky-800 transition-colors"
          >
            Enviar
          </button>
        </form>
    </div>
  </div>
</section>

<!-- Toast de agradecimiento -->
<div
  id="toast"
  class="fixed bottom-4 right-4 bg-green-600 text-white py-2 px-4 rounded shadow-md opacity-0 transition-opacity duration-300 z-50"
>
  ¡Gracias por contactarnos!
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toast = document.getElementById("toast");
    const urlParams = new URLSearchParams(window.location.search);
    const isSuccess = urlParams.get("success") === "true";

    console.log("Toast element:", toast);
    console.log("URL success param:", isSuccess);

    if (isSuccess && toast) {
      toast.classList.add("opacity-100");

      setTimeout(() => {
        toast.classList.remove("opacity-100");
      }, 3000);

      // Limpia la URL
      window.history.replaceState(null, "", window.location.pathname);
    }
  });
</script>

